# Senha de acesso à dash (tela de login)
ADMIN_PASSWORD=
# Segredo aleatório usado para assinar o cookie de sessão
SESSION_SECRET=

# Meta Ads — token de usuário do sistema com acesso à conta da Haskell
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=612696705843205

# Google Ads — refresh token de um usuário com acesso ao MCC BYB
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC BYB (login-customer-id)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=6363710958
# Conta Haskell Cosméticos
GOOGLE_ADS_CUSTOMER_ID=5959379905
# Ação de conversão usada para compras e receita do Google (nome exato). Evita somar ações que contam a mesma venda
# e mantém o histórico coerente. Vazio = coluna "conversões" da plataforma.
GOOGLE_ADS_CONVERSION_ACTION=Nuvemshop Website purchases
# Termos que identificam a marca nas buscas, separados por vírgula (padrão: haskell)
GOOGLE_ADS_BRAND_TERMS=haskell

# Loja (Nuvemshop) — resumo diário de pedidos pagos, servido pelo projeto de conversões da BYB (Supabase)
LOJA_API_URL=https://fngqixhfudrckvvqyccx.supabase.co/functions/v1/painel-loja?cliente=haskell
# Chave de leitura da Haskell (secret HASKELL_PAINEL_KEY no Supabase)
LOJA_API_KEY=
